{
    "name": "antigravity/website-template",
    "description": "Refactored Website Template",
    "license": "proprietary",
    "type": "project",
    "require": {
        "bramus/router": "^1.6",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^7.0",
        "php": "^8.2",
        "league/commonmark": "^2.10",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Controllers\\": "controllers/",
            "Includes\\": "includes/",
            "Models\\": "models/",
            "Services\\": "services/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Antigravity"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    }
}
